{
  "name": "project-ai-api-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Szkoleniowe repozytorium testów API OpenWeatherMap z użyciem Playwright Test i APIRequestContext.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:health": "playwright test --project=health-stations --project=health-weather",
    "test:stations": "playwright test --project=stations",
    "test:weather": "playwright test --project=weather",
    "test:live": "playwright test --project=stations --project=weather",
    "test": "playwright test"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "openweathermap",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "zod": "^3.23.8"
  }
}
