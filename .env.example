# Przykładowa konfiguracja środowiska dla testów API OpenWeatherMap.
# Skopiuj ten plik do `.env` i uzupełnij własnym kluczem ze szkoleniowego konta.
# Plik `.env` jest ignorowany przez git — NIGDY nie commituj prawdziwego klucza.
#
# Na potrzeby szkoleniowe używamy jednego klucza API dla obu usług
# (zarządzanie stacjami oraz aktualna pogoda).

# Klucz API OpenWeatherMap przekazywany jako parametr `appid`.
OPENWEATHER_API_KEY=

# Opcjonalnie: nadpisanie bazowego URL (musi być zaufanym hostem HTTPS: api.openweathermap.org).
# OPENWEATHER_BASE_URL=https://api.openweathermap.org
